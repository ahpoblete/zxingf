# Copy this file to keystore.properties (same directory) and fill in real values.
# keystore.properties is gitignored — never commit your real keystore or its passwords.
#
# Generate a keystore first, if you don't have one:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#       -validity 10000 -alias upload

storeFile=/absolute/path/to/upload-keystore.jks
storePassword=changeit
keyAlias=upload
keyPassword=changeit
